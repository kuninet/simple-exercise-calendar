{
  "name": "simple-exercise-calendar",
  "version": "1.0.0",
  "description": "シンプルなエクササイズカレンダー",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "init-db": "node database.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "playwright test"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "exercise",
    "calendar",
    "fitness",
    "tracking"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6"
  }
}
